# Supabase — Settings → API in your Supabase project
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional — email alert on every new lead/subscriber (Resend). Both must
# be set for the alert to fire; the app runs fine without them.
RESEND_API_KEY=
LEADS_NOTIFY_EMAIL=

# Required for /admin/signup — a shared invite code for creating staff
# accounts. Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(12))"
ADMIN_SIGNUP_CODE=

# Optional — product analytics.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
