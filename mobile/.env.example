# Same Supabase project as the web app (Settings → API)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# The Next.js backend's mobile API (see ../app/api/mobile/**). Must be a
# LAN-reachable address, not localhost — a phone running Expo Go can't
# resolve "localhost" as the dev machine. Find yours from `npm run dev`'s
# own "Network: http://<ip>:3000" line in the web app.
EXPO_PUBLIC_API_BASE_URL=http://192.168.1.100:3000
